generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id          String         @id @default(cuid())
  channel     String
  messageId   Int
  contentHash String         @unique
  sourceUrl   String
  title       String
  description String
  price       Int?
  currency    String?
  rooms       Int?
  bedrooms    Int?
  area        Int?
  district    String?
  postedAt    DateTime
  createdAt   DateTime       @default(now())
  images      ListingImage[]

  @@unique([channel, messageId])
  @@index([postedAt])
  @@index([district])
  @@index([price])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  key       String
  position  Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}
